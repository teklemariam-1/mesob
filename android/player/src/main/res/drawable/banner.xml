<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#0A1628" />
        </shape>
    </item>
    <item android:gravity="center" android:width="96dp" android:height="96dp" android:drawable="@android:drawable/ic_media_play" />
</layer-list>
