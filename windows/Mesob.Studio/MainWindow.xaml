<Window
    x:Class="Mesob.Studio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="18,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/mesob-256.png" Width="20" Height="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Mesob" FontWeight="SemiBold" />
                <TextBlock Text="Studio Control" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border x:Name="StudioBadge" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <TextBlock x:Name="StudioText" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border x:Name="LabBadge" Grid.Column="3" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                    Background="{ThemeResource MesobLabBackground}">
                <TextBlock Text="LAB BUILD" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource MesobWarnBrush}" />
            </Border>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="244"
                        IsPaneOpen="True"
                        CompactModeThresholdWidth="0"
                        ExpandedModeThresholdWidth="0"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Titles" Tag="titles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shops" Tag="shops">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Credits and codes" Tag="credits">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sync sticks" Tag="sync">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE88E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Reports" Tag="reports">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Studio setup" Tag="setup">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
