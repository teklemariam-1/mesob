<Page
    x:Class="Mesob.Studio.TitlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mesob.Studio"
    Background="Transparent">
    <Grid Padding="40,28,40,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="CATALOG" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Titles" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Count" Style="{StaticResource Secondary}" />
            </StackPanel>
            <AutoSuggestBox x:Name="Search" Grid.Column="1" Width="260" VerticalAlignment="Bottom" PlaceholderText="Search titles"
                            QueryIcon="Find" TextChanged="Search_TextChanged" />
            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="Add_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add title" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="Working" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="WorkingText" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Encrypting with a new title key and fingerprinting every chunk. Large videos take a minute." Style="{StaticResource SmallSecondary}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="24,12" ColumnSpacing="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="TITLE" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="SOLD" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="PRICE" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="List" Grid.Row="1" SelectionMode="None" Padding="8,4" IsItemClickEnabled="True" ItemClick="List_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TitleRow">
                            <Grid Padding="4,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="48" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="16" Opacity="0.4" Visibility="{x:Bind NoPoster}" />
                                    <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind TitleEn}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SmallSecondary}" FontFamily="{StaticResource EthiopicFont}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,3" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" />
                                        <TextBlock Text="{x:Bind KindLabel}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Secondary}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind SoldLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="{x:Bind PriceLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                <Button Grid.Column="6" Click="{x:Bind Play}" Width="40" Height="40" CornerRadius="20" Padding="0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind PlayTip}" AutomationProperties.Name="{x:Bind PlayTip}">
                                    <FontIcon Glyph="{x:Bind PlayGlyph}" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B2;" FontSize="36" Opacity="0.5" />
                    <TextBlock Text="No titles yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Add a video, song or book. It's encrypted here and sent to shops on sync sticks." Style="{StaticResource Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentDialog x:Name="AddDialog" Title="Add a title" PrimaryButtonText="Encrypt and add" CloseButtonText="Cancel"
                       DefaultButton="Primary" PrimaryButtonClick="AddDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="560">
                <StackPanel Spacing="14" Width="460">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PickedFile" Header="Media file (.mp4, .m4a, .pdf)" IsReadOnly="True" PlaceholderText="No file chosen" />
                        <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="Pick_Click" />
                    </Grid>
                    <ComboBox x:Name="KindBox" Header="Type" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Video" Tag="video" />
                        <ComboBoxItem Content="Music" Tag="audio" />
                        <ComboBoxItem Content="Book (PDF)" Tag="pdf" />
                    </ComboBox>
                    <TextBox x:Name="TitleEnBox" Header="Title (English)" />
                    <TextBox x:Name="TitleTiBox" Header="Title (Tigrinya)" FontFamily="{StaticResource EthiopicFont}" />
                    <TextBox x:Name="ArtistBox" Header="Artist or author" />
                    <NumberBox x:Name="PriceBox" Header="Shop price (Nakfa)" Value="100" Minimum="0" SpinButtonPlacementMode="Inline" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PickedPoster" Header="Poster (optional, JPEG/PNG under 500 KB)" IsReadOnly="True" PlaceholderText="No poster" />
                        <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="Poster_Click" />
                    </Grid>
                    <TextBlock x:Name="DialogError" Foreground="{ThemeResource MesobBadBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
