<Page
    x:Class="Mesob.Studio.ShopsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mesob.Studio"
    Background="Transparent">
    <Grid Padding="40,28,40,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="DISTRIBUTION" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Shops" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Count" Style="{StaticResource Secondary}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="Setup_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Set up shop" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="24,12" ColumnSpacing="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="SHOP" Style="{StaticResource ColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="CREDITS" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="SOLD" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="SHOP SALES" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="PAID STUDIO" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource ColumnHeader}" />
                </Grid>
                <ListView x:Name="List" Grid.Row="1" SelectionMode="None" Padding="8,4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ShopRow">
                            <Grid Padding="4,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="{x:Bind IdLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Place}" Style="{StaticResource SmallSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind CreditsLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{x:Bind SoldLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{x:Bind RevenueLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="{x:Bind PaidLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Secondary}" />
                                <Grid Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border Padding="10,3" CornerRadius="10" Background="{ThemeResource MesobGoodBackground}" Visibility="{x:Bind ActiveVisibility}">
                                        <TextBlock Text="Active" FontSize="12" Foreground="{ThemeResource MesobGoodBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Padding="10,3" CornerRadius="10" Background="{ThemeResource MesobBadBackground}" Visibility="{x:Bind BlockedVisibility}">
                                        <TextBlock Text="Blocked" FontSize="12" Foreground="{ThemeResource MesobBadBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                                <Button Grid.Column="7" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="More" Click="{x:Bind More}">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE80F;" FontSize="36" Opacity="0.5" />
                    <TextBlock Text="No shops yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Set up a distributor's tablet from the setup request it saves to a USB stick." Style="{StaticResource Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentDialog x:Name="SetupDialog" Title="Set up a shop" PrimaryButtonText="Set up shop" CloseButtonText="Cancel"
                       DefaultButton="Primary" PrimaryButtonClick="SetupDialog_PrimaryButtonClick">
            <StackPanel Spacing="14" Width="440">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}"
                           Text="On the new shop tablet, open Mesob Shop and save its setup request to a USB stick (MESOB\setup-request.json). Plug the stick in here." />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Picked" Header="Setup request" IsReadOnly="True" PlaceholderText="No file chosen" />
                    <Button Grid.Column="1" Content="Browse" VerticalAlignment="Bottom" Click="Pick_Click" />
                </Grid>
                <TextBox x:Name="ShopName" Header="Shop or distributor name" />
                <TextBox x:Name="Town" Header="Town" />
                <TextBox x:Name="Phone" Header="Phone (for codes by SMS)" InputScope="TelephoneNumber" />
                <TextBlock x:Name="DialogError" Foreground="{ThemeResource MesobBadBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
