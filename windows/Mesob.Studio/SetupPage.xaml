<Page
    x:Class="Mesob.Studio.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="40,28,40,36" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="ONE-TIME" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Studio setup" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Text="Three steps, done once. The studio key is created on this PC and never leaves it. The vendor certifies it and sells you license capacity." />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KeyBadge" Style="{StaticResource IconBadge}"><FontIcon x:Name="KeyIcon" FontSize="16" /></Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Studio key" FontWeight="SemiBold" />
                        <TextBlock x:Name="KeyState" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" FontFamily="{StaticResource CodeFont}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="CreateKeyButton" Content="Create key" Click="CreateKey_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="SaveRequestButton" Content="Save request for vendor…" Click="SaveRequest_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CertBadge" Style="{StaticResource IconBadge}"><FontIcon x:Name="CertIcon" FontSize="16" /></Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Studio certificate from the vendor" FontWeight="SemiBold" />
                        <TextBlock x:Name="CertState" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="CertButton" Grid.Column="2" Content="Import certificate…" Click="ImportCert_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="CapBadge" Style="{StaticResource IconBadge}"><FontIcon x:Name="CapIcon" FontSize="16" /></Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="License capacity from the vendor" FontWeight="SemiBold" />
                        <TextBlock x:Name="CapState" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Import capacity…" Click="ImportCap_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Protection on this PC" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" />
            <InfoBar x:Name="Protection" IsOpen="True" IsClosable="False" />
            <InfoBar x:Name="LabNote" IsOpen="False" IsClosable="False" Severity="Warning" Title="Lab build"
                     Message="This build trusts the development vendor key. Never give it to a studio; release builds embed the real vendor key." />
        </StackPanel>
    </ScrollViewer>
</Page>
