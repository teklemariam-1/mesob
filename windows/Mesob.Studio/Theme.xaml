<ResourceDictionary
    x:Class="Mesob.Studio.Theme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Mesob design tokens: warm amber accent on charcoal, status colours, type styles, surfaces. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MesobGoodBrush" Color="#7FD49B" />
            <SolidColorBrush x:Key="MesobGoodBackground" Color="#1C3526" />
            <SolidColorBrush x:Key="MesobWarnBrush" Color="#F2C174" />
            <SolidColorBrush x:Key="MesobWarnBackground" Color="#3A2C14" />
            <SolidColorBrush x:Key="MesobBadBrush" Color="#FF9C8F" />
            <SolidColorBrush x:Key="MesobBadBackground" Color="#3B1E1A" />
            <SolidColorBrush x:Key="MesobTerraBrush" Color="#C8553D" />
            <SolidColorBrush x:Key="MesobLabBackground" Color="#3A2C14" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MesobGoodBrush" Color="#1E7A45" />
            <SolidColorBrush x:Key="MesobGoodBackground" Color="#E3F4E9" />
            <SolidColorBrush x:Key="MesobWarnBrush" Color="#8A5300" />
            <SolidColorBrush x:Key="MesobWarnBackground" Color="#FCEFD8" />
            <SolidColorBrush x:Key="MesobBadBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="MesobBadBackground" Color="#FBE6E3" />
            <SolidColorBrush x:Key="MesobTerraBrush" Color="#B4472F" />
            <SolidColorBrush x:Key="MesobLabBackground" Color="#FCEFD8" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="EthiopicFont">Segoe UI Variable Text, Ebrima, Nyala</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,18" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="FontSize" Value="34" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SmallSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
