<Page
    x:Class="Mesob.Studio.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mesob.Studio"
    Background="Transparent">
    <Grid Padding="40,28,40,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="ACCOUNTING" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Reports" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="Export_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                    <TextBlock Text="Export to Excel" />
                </StackPanel>
            </Button>
        </Grid>

        <SelectorBar x:Name="Kind" Grid.Row="1" SelectionChanged="Kind_SelectionChanged">
            <SelectorBarItem Text="By shop" Tag="shop" IsSelected="True" />
            <SelectorBarItem Text="By title" Tag="title" />
            <SelectorBarItem Text="By day" Tag="day" />
            <SelectorBarItem Text="Daily codes" Tag="codes" />
            <SelectorBarItem Text="Cash received" Tag="cash" />
            <SelectorBarItem Text="Every sale" Tag="log" />
        </SelectorBar>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="24,12" ColumnSpacing="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeadA" Style="{StaticResource ColumnHeader}" />
                    <TextBlock x:Name="HeadB" Grid.Column="1" Text="DETAILS" Style="{StaticResource ColumnHeader}" />
                    <TextBlock x:Name="HeadC" Grid.Column="2" Text="NAKFA" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="List" Grid.Row="1" SelectionMode="None" Padding="8,4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Row">
                            <Grid Padding="4,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource EthiopicFont}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Right}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="Empty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE9D2;" FontSize="36" Opacity="0.5" />
                    <TextBlock Text="Nothing to show yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Sales appear once shops' logs come back on a sync stick." Style="{StaticResource Secondary}" />
                </StackPanel>
                <Grid Grid.Row="2" Padding="24,12" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="0,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TotalLabel" Text="Total" FontWeight="SemiBold" />
                    <TextBlock x:Name="Total" Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
