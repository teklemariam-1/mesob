<Page
    x:Class="Mesob.Player.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <MediaPlayerElement x:Name="Mpe" AreTransportControlsEnabled="True" Stretch="Uniform" />

        <!-- Music: poster, title and artist above the controls. -->
        <StackPanel x:Name="AudioInfo" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,140">
            <Border Width="320" Height="180" CornerRadius="10" Background="#222222">
                <Image x:Name="AudioPoster" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="AudioTitle" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock x:Name="AudioTigrinya" FontSize="20" FontFamily="{StaticResource EthiopicFont}" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
            <TextBlock x:Name="AudioArtist" FontSize="15" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
        </StackPanel>

        <Canvas x:Name="Overlay" IsHitTestVisible="False">
            <TextBlock x:Name="Watermark" Foreground="White" Opacity="0.3" FontSize="16" FontFamily="{StaticResource CodeFont}" />
        </Canvas>

        <!-- Top bar -->
        <Grid VerticalAlignment="Top" Padding="16,12" ColumnSpacing="12">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B0000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" Background="#33FFFFFF" BorderThickness="0" Width="40" Height="40" CornerRadius="20" Padding="0"
                    ToolTipService.ToolTip="Back to library">
                <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="White" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubText" Foreground="#AAFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Problem" Visibility="Collapsed" Spacing="12" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE7BA;" FontSize="34" Foreground="#F2C174" />
            <TextBlock x:Name="ProblemText" Foreground="White" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
