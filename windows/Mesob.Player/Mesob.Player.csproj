<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Mesob.Player</RootNamespace>
    <AssemblyName>MesobPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\Assets\mesob.ico</ApplicationIcon>
    <Product>Mesob Player</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mesob.Interop\Mesob.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Assets\mesob.ico" Link="Assets\mesob.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\mesob-256.png" Link="Assets\mesob-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
