<Page
    x:Class="Mesob.Player.ShopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mesob.Player"
    Background="Transparent">
    <Grid>
        <Grid Padding="40,28,40,24" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="BUY AT A MESOB SHOP" Style="{StaticResource Eyebrow}" />
                    <TextBlock x:Name="ShopHeading" Text="Shop" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="ShopSub" Style="{StaticResource Secondary}" Text="Browse what the shop sells, fill your cart, and pay cash at the counter." />
                </StackPanel>
                <Button x:Name="LeaveButton" Grid.Column="1" VerticalAlignment="Bottom" Visibility="Collapsed" Click="Leave_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                        <TextBlock Text="Leave shop" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="ConnectCard" Grid.Row="1" Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}" VerticalAlignment="Center">
                        <FontIcon x:Name="ConnIcon" Glyph="&#xE701;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ConnTitle" Text="Connect to a shop" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConnText" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                   Text="Join the shop's Wi-Fi, then enter the address shown on the shop's screen. No internet is needed." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBox x:Name="AddressBox" Width="230" PlaceholderText="e.g. 192.168.8.10" KeyDown="Address_KeyDown" />
                        <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="96" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="Toolbar" Grid.Row="2" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar x:Name="KindFilter" SelectionChanged="KindFilter_SelectionChanged">
                    <SelectorBarItem Text="All" Tag="all" IsSelected="True" />
                    <SelectorBarItem Text="Video" Tag="video" />
                    <SelectorBarItem Text="Music" Tag="audio" />
                    <SelectorBarItem Text="Books" Tag="pdf" />
                </SelectorBar>
                <AutoSuggestBox x:Name="StoreSearch" Grid.Column="1" Width="300" VerticalAlignment="Center" PlaceholderText="Search titles and artists"
                                QueryIcon="Find" TextChanged="StoreSearch_TextChanged" />
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CartColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <GridView x:Name="CatalogGrid" SelectionMode="None" Padding="0,0,0,24" Visibility="Collapsed">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Margin" Value="0,0,16,20" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:CatalogItem">
                            <StackPanel Width="228">
                                <Grid Height="128" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="36" Opacity="0.35" />
                                    <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill" />
                                    <Border Background="#99101010" CornerRadius="4" Padding="7,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" Foreground="White" />
                                            <TextBlock Text="{x:Bind KindLabel}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                    <Border Visibility="{x:Bind InCartVisibility, Mode=OneWay}" Width="34" Height="34" CornerRadius="17" Margin="10"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind TitleEn}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
                                <TextBlock Text="{x:Bind TitleTi}" FontFamily="{StaticResource EthiopicFont}" TextTrimming="CharacterEllipsis" Margin="2,1,2,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Byline}" Style="{StaticResource SmallSecondary}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
                                <Grid Margin="2,10,2,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind PriceLabel}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Visibility="{x:Bind OwnedVisibility, Mode=OneWay}" CornerRadius="10" Padding="10,3" Background="{ThemeResource MesobGoodBackground}">
                                        <TextBlock Text="Owned" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MesobGoodBrush}" />
                                    </Border>
                                    <Button Grid.Column="1" Visibility="{x:Bind AddVisibility, Mode=OneWay}" Click="{x:Bind Toggle}" Style="{StaticResource AccentButtonStyle}" Padding="12,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7BF;" FontSize="13" />
                                            <TextBlock Text="Add" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Visibility="{x:Bind InCartVisibility, Mode=OneWay}" Click="{x:Bind Toggle}" Padding="12,4"
                                            ToolTipService.ToolTip="Take out of the cart">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                            <TextBlock Text="In cart" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel x:Name="NotConnected" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="0,0,0,60">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE719;" FontSize="30" />
                    </Border>
                    <TextBlock Text="Not connected" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="NotConnectedText" Style="{StaticResource Secondary}" TextAlignment="Center" TextWrapping="Wrap"
                               Text="At the shop, join its Wi-Fi and connect. Add what you like to your cart, place the order, and pay cash at the counter with your code." />
                </StackPanel>
                <TextBlock x:Name="NoMatch" Visibility="Collapsed" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />

                <Border x:Name="CartPanel" Grid.Column="1" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="20,18,20,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BF;" FontSize="18" />
                            <TextBlock Grid.Column="1" Text="Your cart" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <InfoBadge x:Name="CartBadge" Grid.Column="2" Value="0" VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="CartList" Grid.Row="1" SelectionMode="None" Padding="8,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CartLine">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Height="36" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Opacity="0.4" />
                                            <Image Source="{x:Bind Picture}" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Amount}" Style="{StaticResource SmallSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="{x:Bind Remove}" Background="Transparent" BorderThickness="0" Padding="6"
                                                ToolTipService.ToolTip="Remove" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="CartEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Padding="24">
                            <TextBlock Text="Your cart is empty" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Choose Add on anything you like." Style="{StaticResource SmallSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Padding="20,14,20,20" Spacing="10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid>
                                <TextBlock Text="Total" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CartTotal" Text="0 Nakfa" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                       Text="You'll get a short code. Show it at the counter and pay cash; your titles then download here and play only on this PC." />
                            <InfoBar x:Name="CartError" IsOpen="False" Severity="Error" IsClosable="True" />
                            <Button x:Name="PlaceButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Padding="0,10" Click="Place_Click" IsEnabled="False">
                                <TextBlock x:Name="PlaceText" Text="Place order" FontSize="15" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="OrderOverlay" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ScrollViewer>
                <StackPanel MaxWidth="560" Padding="24,48" Spacing="16" HorizontalAlignment="Center">
                    <TextBlock x:Name="OrderHeading" Text="Show this code at the counter" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <Border x:Name="CodeCard" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="20" Padding="40,8" HorizontalAlignment="Center">
                        <TextBlock x:Name="CodeText" FontFamily="{StaticResource CodeFont}" FontSize="96" FontWeight="Bold" CharacterSpacing="120"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    </Border>
                    <FontIcon x:Name="DoneIcon" Glyph="&#xE930;" FontSize="72" Foreground="{ThemeResource MesobGoodBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="OrderPay" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="OrderShop" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
                    <Border x:Name="OrderLinesCard" Style="{StaticResource Card}">
                        <ItemsControl x:Name="OrderLines">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CartLine">
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Height="36" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Opacity="0.4" />
                                            <Image Source="{x:Bind Picture}" Stretch="UniformToFill" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Amount}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <StackPanel x:Name="WaitingRow" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <ProgressRing IsActive="True" Width="18" Height="18" />
                        <TextBlock x:Name="OrderStatusText" Style="{StaticResource Secondary}" TextWrapping="Wrap" MaxWidth="460" />
                    </StackPanel>
                    <ProgressBar x:Name="OrderProgress" Maximum="100" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button x:Name="OpenLibraryButton" Content="Open library" Style="{StaticResource AccentButtonStyle}" Click="OpenLibrary_Click" Visibility="Collapsed" Padding="24,8" />
                        <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource AccentButtonStyle}" Click="Retry_Click" Visibility="Collapsed" />
                        <Button x:Name="BackToShopButton" Content="Change my order" Click="BackToShop_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
