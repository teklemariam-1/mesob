<Page
    x:Class="Mesob.Player.DevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Padding="40,28,40,32" Spacing="14" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="LICENSES AND PROTECTION" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="This device" Style="{StaticResource PageTitle}" />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE7F8;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Device code" FontWeight="SemiBold" />
                        <TextBlock x:Name="Fingerprint" FontFamily="{StaticResource CodeFont}" FontSize="20" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                   Text="Every license is made for this code. After reinstalling Windows or on a new PC, bring your receipt serial number to any Mesob shop for a free replacement." />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Top" Click="Copy_Click" ToolTipService.ToolTip="Copy device code">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock x:Name="CopyLabel" Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xEA18;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="Protection" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="KeyIcon" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="KeyTitle" FontWeight="SemiBold" />
                                <TextBlock x:Name="KeyText" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CaptureIcon" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CaptureTitle" FontWeight="SemiBold" />
                                <TextBlock x:Name="CaptureText" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" Foreground="{ThemeResource MesobGoodBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Watermarked playback" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SmallSecondary}" TextWrapping="Wrap"
                                           Text="A faint moving code with your license serial appears on videos and book pages." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="About" FontWeight="SemiBold" />
                        <TextBlock x:Name="Build" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                        <TextBlock x:Name="Folder" Style="{StaticResource SmallSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
