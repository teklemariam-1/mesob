<Page
    x:Class="Mesob.Player.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mesob.Player"
    Background="Transparent">
    <Grid Padding="40,28,40,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="YOUR COLLECTION" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Library" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Click="MakeRequest_Click" ToolTipService.ToolTip="Save a request for the shop on a USB stick (for buying without Wi-Fi)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE88E;" FontSize="16" />
                        <TextBlock Text="Request file" />
                    </StackPanel>
                </Button>
                <DropDownButton Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                        <TextBlock Text="Add" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Title files (.msb)…" Click="AddTitles_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="License files (.msl, .msls)…" Click="AddLicenses_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Filter" SelectionChanged="Filter_SelectionChanged">
                <SelectorBarItem Text="All" Tag="all" IsSelected="True" />
                <SelectorBarItem Text="Video" Tag="video" />
                <SelectorBarItem Text="Music" Tag="audio" />
                <SelectorBarItem Text="Books" Tag="pdf" />
            </SelectorBar>
            <AutoSuggestBox x:Name="Search" Grid.Column="1" PlaceholderText="Search titles" QueryIcon="Find"
                            VerticalAlignment="Center" TextChanged="Search_TextChanged" />
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" />

        <GridView x:Name="Items" Grid.Row="3" IsItemClickEnabled="True" ItemClick="Items_ItemClick" SelectionMode="None" Padding="0,0,0,24">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0,0,18,22" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:LibraryItem">
                    <StackPanel Width="248">
                        <Grid Height="140" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="40" Opacity="0.35" Visibility="{x:Bind NoPosterVisibility}" />
                            <Image Source="{x:Bind PosterImage}" Stretch="UniformToFill" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.45" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#B0000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Border Background="#99101010" CornerRadius="4" Padding="7,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" Foreground="White" />
                                    <TextBlock Text="{x:Bind KindLabel}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="White" />
                                </StackPanel>
                            </Border>
                            <Grid Visibility="{x:Bind LockedVisibility}" Background="#66000000">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#CC101010" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="White" />
                                </Border>
                            </Grid>
                            <Border Visibility="{x:Bind OwnedVisibility}" Width="40" Height="40" CornerRadius="20" Margin="10"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind TitleEn}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
                        <TextBlock Text="{x:Bind TitleTi}" FontFamily="{StaticResource EthiopicFont}" FontSize="15" TextTrimming="CharacterEllipsis" Margin="2,1,2,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="2,8,2,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Visibility="{x:Bind OwnedVisibility}" CornerRadius="10" Padding="8,1" Background="{ThemeResource MesobGoodBackground}">
                                <TextBlock Text="Yours" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MesobGoodBrush}" />
                            </Border>
                            <Border Visibility="{x:Bind LockedVisibility}" CornerRadius="10" Padding="8,1" Background="{ThemeResource MesobWarnBackground}">
                                <TextBlock Text="Locked" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MesobWarnBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind Byline}" Style="{StaticResource SmallSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="Empty" Grid.Row="3" Visibility="Collapsed" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="0,0,0,80">
            <Border Width="72" Height="72" CornerRadius="36" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8F1;" FontSize="30" />
            </Border>
            <TextBlock x:Name="EmptyTitle" Text="Your library is empty" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" TextAlignment="Center"
                       Text="Buy at a Mesob shop over its Wi-Fi, or add title and license files from a USB stick. Files from friends stay locked until you buy them." />
        </StackPanel>
    </Grid>
</Page>
