<Page
    x:Class="Mesob.Player.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,10" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" Width="40" Height="40" CornerRadius="20" Padding="0" ToolTipService.ToolTip="Back to library">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="BookTitle" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BookSub" Style="{StaticResource SmallSecondary}" FontFamily="{StaticResource EthiopicFont}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="Prev_Click" Width="40" Height="36" Padding="0" ToolTipService.ToolTip="Previous page">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                </Button>
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="96" TextAlignment="Center" />
                <Button Click="Next_Click" Width="40" Height="36" Padding="0" ToolTipService.ToolTip="Next page">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Scroller" ZoomMode="Enabled" HorizontalScrollBarVisibility="Auto" Padding="0,24">
                <Border HorizontalAlignment="Center" CornerRadius="4" Background="White">
                    <Image x:Name="PageImage" Stretch="None" />
                </Border>
            </ScrollViewer>
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <TextBlock x:Name="Watermark" Foreground="Gray" Opacity="0.4" FontSize="15" FontFamily="{StaticResource CodeFont}" />
            </Canvas>
            <StackPanel x:Name="Problem" Visibility="Collapsed" Spacing="12" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="34" Foreground="#F2C174" />
                <TextBlock x:Name="ProblemText" FontSize="17" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
