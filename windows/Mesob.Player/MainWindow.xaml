<Window
    x:Class="Mesob.Player.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: the Mesob mark, app name and build badge. Window buttons are drawn by Windows. -->
        <Grid x:Name="AppTitleBar" Padding="18,0,140,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/mesob-256.png" Width="20" Height="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Mesob" FontWeight="SemiBold" />
                <TextBlock Text="Player" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border x:Name="LabBadge" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                    Background="{ThemeResource MesobLabBackground}">
                <TextBlock x:Name="LabText" Text="LAB BUILD" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource MesobWarnBrush}" />
            </Border>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="232"
                        IsPaneOpen="True"
                        CompactModeThresholdWidth="0"
                        ExpandedModeThresholdWidth="0"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Auto"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="Nav_SelectionChanged"
                        BackRequested="Nav_BackRequested">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Library" Tag="library">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shop" Tag="shop">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="This device" Tag="device">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
